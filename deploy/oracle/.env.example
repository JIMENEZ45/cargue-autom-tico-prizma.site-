# Configuracion del despliegue en Oracle Cloud. Copiar a .env (en esta misma
# carpeta) y completar. El archivo .env NUNCA se sube a git (.gitignore).
# Ver docs/DEPLOY_ORACLE.md.

# Dominio publico de la app, sin https:// (p. ej. un subdominio gratis de DuckDNS).
APP_DOMAIN=mi-cargue.duckdns.org

# Clave para firmar las cookies de sesion. Generarla en el servidor con:
#   openssl rand -hex 32
AUTO_PRIZMA_SECRET=

# Cookie solo por HTTPS (Caddy siempre sirve HTTPS).
AUTO_PRIZMA_COOKIE_SECURE=1

# Google OAuth. La URI debe estar registrada en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mi-cargue.duckdns.org/google/callback

# Vacio = PRIZMA de produccion. Para probar: https://admin.prizma.solutions
AUTO_PRIZMA_URL_PRIZMA=

# Cargues simultaneos: 1 o 2.
AUTO_PRIZMA_MAX_SIMULTANEOS=2
