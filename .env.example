# Variables de entorno de Auto Prizma Pro.
# Copia los nombres que necesites a tu entorno (PowerShell: $env:NOMBRE = "valor")
# o a la configuracion de Railway. La app NO lee archivos .env automaticamente.
# Nunca subas valores reales al repositorio.

# --- Google OAuth (obligatorias para analizar matrices por enlace de Google Sheets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe apuntar a la ruta /google/callback de la app y estar registrada en Google Cloud.
# Local: http://127.0.0.1:8000/google/callback
GOOGLE_REDIRECT_URI=

# --- Sesiones ---
# Clave para firmar las cookies de sesion. Si falta, se genera data/secreto_sesion.txt.
AUTO_PRIZMA_SECRET=
# "1" fuerza la cookie Secure (tambien se activa si GOOGLE_REDIRECT_URI es https).
AUTO_PRIZMA_COOKIE_SECURE=

# --- PRIZMA ---
# Vacio = produccion (https://admin.prizma.site). Para probar sin tocar produccion,
# usar el ambiente de pruebas y reiniciar la app:
# AUTO_PRIZMA_URL_PRIZMA=https://admin.prizma.solutions
AUTO_PRIZMA_URL_PRIZMA=

# --- Datos y cargues ---
# Carpeta de datos persistentes (usuarios, tokens, historial, reportes). Por defecto ./data
AUTO_PRIZMA_DATA_DIR=
# Cargues simultaneos: 1 o 2 (cualquier otro valor se trata como 2).
AUTO_PRIZMA_MAX_SIMULTANEOS=
